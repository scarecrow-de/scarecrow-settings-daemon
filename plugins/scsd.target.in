[Unit]
Description=@description@ target
CollectMode=inactive-or-failed

# Pull in the service
Wants=@plugin_dbus_name@.service

# Require GNOME session and specify startup ordering
Requisite=scarecrow-session-initialized.target
After=scarecrow-session-initialized.target
PartOf=scarecrow-session-initialized.target
Before=scarecrow-session.target
